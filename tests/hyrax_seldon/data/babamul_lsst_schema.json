me":"trail_flag","type":["null","boolean"]},{"name":"trailAlgorithm","type":["null","int"]},{"name":"scienceFlux","type":["null","float"]},{"name":"scienceFluxErr","type":["null","float"]},{"name":"forced_PsfFlux_flag","type":["null","boolean"]},{"name":"forced_PsfFlux_flag_edge","type":["null","boolean"]},{"name":"forced_PsfFlux_flag_noGoodPixels","type":["null","boolean"]},{"name":"templateFlux","type":["null","float"]},{"name":"templateFluxErr","type":["null","float"]},{"name":"shape_flag","type":["null","boolean"]},{"name":"shape_flag_no_pixels","type":["null","boolean"]},{"name":"shape_flag_not_contained","type":["null","boolean"]},{"name":"shape_flag_parent_source","type":["null","boolean"]},{"name":"extendedness","type":["null","float"]},{"name":"reliability","type":["null","float"]},{"name":"reliabilityVersion","type":["null","string"]},{"name":"band","type":["null",{"type":"enum","name":"Band","symbols":["g","r","i","z","y","u","j","h","k"]}]},{"name":"isDipole","type":["null","boolean"]},{"name":"pixelFlags","type":["null","boolean"]},{"name":"pixelFlags_bad","type":["null","boolean"]},{"name":"pixelFlags_cr","type":["null","boolean"]},{"name":"pixelFlags_crCenter","type":["null","boolean"]},{"name":"pixelFlags_edge","type":["null","boolean"]},{"name":"pixelFlags_nodata","type":["null","boolean"]},{"name":"pixelFlags_nodataCenter","type":["null","boolean"]},{"name":"pixelFlags_interpolated","type":["null","boolean"]},{"name":"pixelFlags_interpolatedCenter","type":["null","boolean"]},{"name":"pixelFlags_offimage","type":["null","boolean"]},{"name":"pixelFlags_saturated","type":["null","boolean"]},{"name":"pixelFlags_saturatedCenter","type":["null","boolean"]},{"name":"pixelFlags_suspect","type":["null","boolean"]},{"name":"pixelFlags_suspectCenter","type":["null","boolean"]},{"name":"pixelFlags_streak","type":["null","boolean"]},{"name":"pixelFlags_streakCenter","type":["null","boolean"]},{"name":"pixelFlags_injected","type":["null","boolean"]},{"name":"pixelFlags_injectedCenter","type":["null","boolean"]},{"name":"pixelFlags_injected_template","type":["null","boolean"]},{"name":"pixelFlags_injected_templateCenter","type":["null","boolean"]},{"name":"glint_trail","type":["null","boolean"]},{"name":"objectId","type":"string"},{"name":"jd","type":"double"},{"name":"magpsf","type":"float"},{"name":"sigmapsf","type":"float"},{"name":"snr_psf","type":["null","float"]},{"name":"chipsf","type":["null","float"]},{"name":"diffmaglim","type":"float"},{"name":"isdiffpos","type":"boolean"},{"name":"magap","type":"float"},{"name":"sigmagap","type":"float"},{"name":"snr_ap","type":["null","float"]},{"name":"jdstarthist","type":["null","double"]},{"name":"ndethist","type":["null","int"]},{"name":"observation_reason","type":["null","string"]},{"name":"target_name","type":["null","string"]}]}},{"name":"prv_candidates","type":{"type":"array","items":{"type":"record","name":"AlertPhotometry","fields":[{"name":"jd","type":"double"},{"name":"psfFlux","type":"double"},{"name":"psfFluxErr","type":"double"},{"name":"band","type":"Band"},{"name":"ra","type":"double"},{"name":"dec","type":"double"}]}}},{"name":"fp_hists","type":{"type":"array","items":{"type":"record","name":"ForcedPhotometry","fields":[{"name":"jd","type":"double"},{"name":"psfFlux","type":["null","double"]},{"name":"psfFluxErr","type":"double"},{"name":"band","type":"Band"}]}}},{"name":"properties","type":{"type":"record","name":"LsstAlertProperties","doc":"LSST alert properties computed during enrichment and inserted back into the alert document","fields":[{"name":"rock","type":"boolean"},{"name":"stationary","type":"boolean"},{"name":"star","type":["null","boolean"]},{"name":"near_brightstar","type":["null","boolean"]},{"name":"hosted","type":["null","boolean"]},{"name":"photstats","type":{"type":"record","name":"PerBandProperties","doc":"Per-band light-curve fits, reached at `properties.photstats.<band>` -- so a\ndecline rate is `properties.photstats.r.fading.rate`. Null for a band the\nobject has no detections in.","fields":[{"name":"g","type":["null",{"type":"record","name":"BandProperties","fields":[{"name":"peak_jd","type":"double"},{"name":"peak_mag","type":"float"},{"name":"peak_mag_err","type":"float"},{"name":"dt","type":"float"},{"name":"rising","type":["null",{"type":"record","name":"BandRateProperties","fields":[{"name":"rate","type":"float"},{"name":"rate_error","type":"float"},{"name":"chi2","type":["null","float"]},{"name":"dof","type":["null","int"]},{"name":"red_chi2","type":["null","float"]},{"name":"nb_data","type":"int"},{"name":"dt","type":"float"}]}]},{"name":"fading","type":["null","BandRateProperties"]},{"name":"recent","type":["null",{"type":"record","name":"RecentProperties","doc":"Fits over the last [`RECENT_WINDOW_DAYS`] only.\n\nPresent whenever the window holds any detection, so \"no recent data\" (null)\nstays distinguishable from \"recent data that cannot be fit\" (present, with\n`rising` and `fading` null). Most objects in the alert stream are sampled too\nsparsely for a windowed fit; that is a fact about the cadence, and reporting\nit as absent is the honest outcome rather than a defect.","fields":[{"name":"window_days","type":"float"},{"name":"nb_data","type":"int"},{"name":"peak_jd","type":"double"},{"name":"peak_mag","type":"float"},{"name":"rising","type":["null","BandRateProperties"]},{"name":"fading","type":["null","BandRateProperties"]}]}]}]}]},{"name":"r","type":["null","BandProperties"]},{"name":"i","type":["null","BandProperties"]},{"name":"z","type":["null","BandProperties"]},{"name":"y","type":["null","BandProperties"]},{"name":"u","type":["null","BandProperties"]},{"name":"j","type":["null","BandProperties"]},{"name":"h","type":["null","BandProperties"]},{"name":"k","type":["null","BandProperties"]}]}},{"name":"multisurvey_photstats","type":"PerBandProperties"},{"name":"sso","type":["null",{"type":"record","name":"LsstSsoAssociation","doc":"Solar system association for a single LSST detection, mirroring the ZTF block so\na filter reads identically on both surveys.\n\nRubin supplies the ephemeris directly in `ssSource`, so unlike ZTF nothing here\nis derived: the predicted magnitude, the observed-minus-predicted separation and\nthe predicted sky motion all come from `mpc_orbits` upstream.","fields":[{"name":"is_sso","type":"boolean"},{"name":"designation","type":["null","string"]},{"name":"separation_arcsec","type":["null","float"]},{"name":"predicted_mag","type":["null","float"]},{"name":"sky_motion","type":["null","float"]},{"name":"phase_angle","type":["null","float"]},{"name":"helio_dist","type":["null","float"]},{"name":"topo_dist","type":["null","float"]},{"name":"source","type":["null","string"]}]}]},{"name":"activity","type":["null",{"type":"record","name":"ActivityMetrics","doc":"Morphological indicators of cometary activity, computed per survey but expressed\non one scale so a filter reads identically on ZTF and LSST.","fields":[{"name":"aperture_excess","type":["null","float"]},{"name":"outburst","type":["null",{"type":"record","name":"Outburst","doc":"How much brighter a moving object is than its own recent history, in sigma.\n\nEvery value compares the detection under test against an earlier detection of\nthe same object, both scaled to the test epoch's observing geometry with an\nHG12 phase function. Positive means brighter than history.","fields":[{"name":"d7","type":["null","float"]},{"name":"d14","type":["null","float"]},{"name":"d30","type":["null","float"]},{"name":"points","type":{"type":"array","items":{"type":"record","name":"OutburstPoint","doc":"One entry of `Outburst::points`.","fields":[{"name":"jd","type":"double"},{"name":"sigma","type":"float"}]}}},{"name":"scatter","type":["null","float"]},{"name":"baseline","type":["null","float"]}]}]}]}]},{"name":"detection_history","type":["null",{"type":"record","name":"DetectionHistory","doc":"Per-object detection-history summary, computed at enrichment from the object's\naccumulated light curve and written onto every alert so filters can make\nhistory-aware cuts (e.g. \"steady star that just started going negative\") with a\nplain `$match`. BOOM filter pipelines are strictly per-alert and reject\n`$group`/`$unwind`/`$lookup`, so the history has to be precomputed here.\n\nEach survey feeds `(jd, is_negative)` points from its own light curve — sign\nfrom the psfFlux sign (ZTF/LSST), `isdiffpos` (WINTER), or the signed SNR\n(DECam). Windows are measured back from the alert epoch, keeping the values\ndeterministic per alert rather than dependent on wall-clock time at enrichment.","fields":[{"name":"n_det","type":"int"},{"name":"n_pos","type":"int"},{"name":"n_neg","type":"int"},{"name":"first_neg_jd","type":["null","double"]},{"name":"last_neg_jd","type":["null","double"]},{"name":"n_pos_30d","type":"int"},{"name":"n_neg_30d","type":"int"},{"name":"first_activity_jd","type":["null","double"]},{"name":"last_detection_jd","type":["null","double"]},{"name":"n_forced_detections","type":"int"}]}]},{"name":"episode_history","type":["null",{"type":"record","name":"EpisodeHistory","doc":"Detection episodes in an object's light curve, for finding sources that\noutburst more than once.\n\nAn episode is a run of positive detections separated from the next run by\nmore than [`EPISODE_GAP_DAYS`]. Recurrence is a statement about a whole\nlight curve, and filter pipelines are strictly per-alert, so it is computed\nhere alongside [`DetectionHistory`].\n\n`n_episodes` measures when the object alerted, not when it was observed: a\nnight the survey skipped is indistinguishable from one it was quiet, so a\nsurvey-wide outage adds an episode boundary to every densely sampled object\nat once. It separates recurrence from one-off transients well, and does not\nseparate it from ordinary variability -- on 276 classified CVs, 80% of\nrecurrers and 10% of one-off transients pass `n_episodes >= 2`, against 93%\nof variable stars, which a catalogue cross-match is what removes.\n\nGaps are quiescent intervals -- the end of one episode to the start of the\nnext -- which is the same quantity `gap_days` thresholds on. An orbital\nperiod is that plus the episode's own duration, so comparing successive\ngaps tracks a lengthening period only while episode durations are similar.","fields":[{"name":"n_episodes","type":"int"},{"name":"gap_days","type":"double"},{"name":"last_gap_days","type":["null","double"]},{"name":"prev_gap_days","type":["null","double"]},{"name":"longest_quiet_days","type":["null","double"]},{"name":"first_episode_jd","type":["null","double"]},{"name":"last_episode_jd","type":["null","double"]}]}]}]}},{"name":"survey_matches","type":{"type":"record","name":"BabamulSurveyMatches","fields":[{"name":"ztf","type":["null",{"type":"record","name":"BabamulSurveyMatch","fields":[{"name":"objectId","type":"string"},{"name":"ra","type":"double"},{"name":"dec","type":"double"},{"name":"prv_candidates","type":{"type":"array","items":"AlertPhotometry"}},{"name":"prv_nondetections","type":{"type":"array","items":{"type":"record","name":"NonDetectionPhotometry","fields":[{"name":"jd","type":"double"},{"name":"psfFluxErr","type":"double"},{"name":"band","type":"Band"}]}}},{"name":"fp_hists","type":{"type":"array","items":"ForcedPhotometry"}}]}]},{"name":"lsst","type":["null","BabamulSurveyMatch"]}]}}]}